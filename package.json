{
  "name": "omen-workshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3110",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3110",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/game/interaction/proximity.test.ts src/game/player/animations.test.ts src/store/gameStore.test.ts src/store/settingsStore.test.ts",
    "inspect:assets": "node scripts/inspect-assets.mjs",
    "prepare:character": "node scripts/prepare-character.mjs",
    "fetch:world-assets": "node scripts/fetch-world-assets.mjs",
    "build:kit": "flatpak run org.blender.Blender -b -P scripts/blender/build-world-kit.py && node scripts/optimize-world-kit.mjs",
    "optimize:kit": "node scripts/optimize-world-kit.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "@react-three/rapier": "^2.2.0",
    "gsap": "^3.15.0",
    "next": "16.4.0",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "meshoptimizer": "^1.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
